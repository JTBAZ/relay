  producer   String?
  occurredAt DateTime @map("occurred_at")
  ingestedAt DateTime @default(now()) @map("ingested_at")
  sessionKey String?  @map("session_key")
  actorKey   String?  @map("actor_key")
  creatorId  String?  @map("creator_id")
  payload    Json     @default("{}")
  traceId    String?  @map("trace_id")

  @@index([eventName, occurredAt])
  @@index([occurredAt])
  @@index([creatorId, occurredAt])
  @@map("platform_telemetry_events")
}

/// PMD-050 — idempotent daily rollup storage for operator dashboard metrics.
model PlatformMetricDailyRollup {
  id              String   @id @default(cuid())
  metricKey       String   @map("metric_key")
  dayUtc          DateTime @map("day_utc") @db.Date
  scope           String
  /// Empty string denotes platform/system-wide rollups.
  scopeId         String   @default("") @map("scope_id")
