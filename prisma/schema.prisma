/// Coach Plan credit ledger kinds (VS2). Append-only; corrections are compensating rows.
enum CoachPlanCreditEntryKind {
  monthly_grant
  admin_grant
  reserve
  consume
  release
  expire
  correction
}

/// Append-only Coach Plan credit ledger — wallet truth is the sum of amounts.
/// Application code must not UPDATE/DELETE rows; use compensating entries.
model CoachPlanCreditLedger {
  id             String                   @id @default(cuid())
  creatorId      String                   @map("creator_id")
  /// Signed integer credits. Grants/release > 0; reserve/consume/expire < 0; correction either.
