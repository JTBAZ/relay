  createdAt      DateTime                 @default(now()) @map("created_at")

  cycle CreatorGoalCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([creatorId, idempotencyKey])
  @@index([creatorId, occurredAt])
  @@index([cycleId])
  @@index([reservationKey])
  @@map("coach_plan_credit_ledger")
}

