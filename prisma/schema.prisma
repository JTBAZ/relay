  note                String?                         @db.Text
  dueAt               DateTime                        @map("due_at")
  enabled             Boolean                         @default(true)
  status              CreatorSocialPlaybookStepStatus @default(pending)
  materializedEventId String?                         @map("materialized_event_id")
  materializedTaskId  String?                         @map("materialized_task_id")
  materializedDraftId String?                         @map("materialized_draft_id")
  materializedPostId  String?                         @map("materialized_post_id")
  failureReason       String?                         @map("failure_reason") @db.Text
  /// Frozen atom definition at apply time (JSON).
  atomSnapshot        Json                            @map("atom_snapshot")
  createdAt           DateTime                        @default(now()) @map("created_at")
  updatedAt           DateTime                        @updatedAt @map("updated_at")

  @@unique([runId, stepIndex])
  @@index([creatorId, dueAt])
  @@index([materializedEventId])
  @@index([materializedTaskId])
  @@map("creator_social_playbook_steps")
}

model PostbotTask {
  id                   String                  @id @default(cuid())
  creatorId            String                  @map("creator_id")
  postId               String                  @map("post_id")
  planId               String?                 @map("plan_id")
  plan                 PostDistributionPlan?   @relation(fields: [planId], references: [id], onDelete: SetNull)
  variantId            String                  @map("variant_id")
  variant              PostDistributionVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  destination          String
  action               PostbotTaskAction
  rationale            String                  @db.Text
  suggestedTime        DateTime?               @map("suggested_time")
  link                 String?
  status               PostbotTaskStatus       @default(pending)
  /// Phase 5 — nullable; null falls back to linked variant.remindMe for effective notify.
  remindMe             Boolean?                @map("remind_me")
  /// Extension sticky toast idempotency (separate from variant.reminderSentAt in-app channel).
  reminderSentAt       DateTime?               @map("reminder_sent_at")
  snoozedUntil         DateTime?               @map("snoozed_until")
  /// Opaque Goal Cycle campaign key (VS4). Nullable for legacy tasks.
  goalCycleCampaignKey String?                 @map("goal_cycle_campaign_key")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  @@index([creatorId, status])
  @@index([variantId])
  @@index([postId])
  @@index([creatorId, status, reminderSentAt])
  @@index([goalCycleCampaignKey])
  @@map("postbot_tasks")
}

/// WI-8 — encrypted Bluesky app password for server-side cross-post publish.
model CreatorBlueskyCredential {
  creatorId            String   @id @map("creator_id")
  handle               String
  encryptedAppPassword Bytes    @map("encrypted_app_password")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("creator_bluesky_credentials")
}

/// Replaces `gallery_post_overrides.json` — one row per (creator, post, media scope).
///
/// PE-F (BO-P3-01) — `discoveryEligible` opts the post into `GET /api/v1/patron/discover`.
/// Only meaningful on post-level rows (mediaId=""); per-media rows ignore the flag because
/// discovery surfaces whole posts, not individual assets. Default false: opt-in only, no
/// surprise public exposure when the override row is created for some other reason.
model PostOverride {
  id                String             @id @default(cuid())
  creatorId         String             @map("creator_id")
  postId            String             @map("post_id")
  /// Empty string = post-level override; otherwise canonical `media_id` for per-asset rows.
  mediaId           String             @default("") @map("media_id")
  addTagIds         String[]           @default([]) @map("add_tag_ids")
  removeTagIds      String[]           @default([]) @map("remove_tag_ids")
  visibility        GalleryVisibility?
  /// PE-F discovery v1 — when true (and Post.isPublic=true), surfaced in /patron/discover.
  /// Only honored on post-level rows.
  discoveryEligible Boolean            @default(false) @map("discovery_eligible")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@unique([creatorId, postId, mediaId])
  @@index([creatorId])
  @@index([discoveryEligible])
  @@map("post_overrides")
}

/// Relay-controlled presentation overlays for gallery / Inspect surfaces — **not** ingested snapshots.
///
/// Patreon ingest remains append-only on `PostVersion`; this row merges at read time with latest version
/// (see `docs/relay-artist-metadata.md`). `PostOverride` stays dedicated to tags, visibility, and discovery flags.
///
/// At most one row per `Post`; `creator_id` matches `Post.creator_id` and is indexed for scoped APIs.
model PostPresentation {
  id                  String   @id @default(cuid())
  creatorId           String   @map("creator_id")
  postId              String   @unique @map("post_id")
  post                Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  relayTitle          String?  @map("relay_title")
  relayDescription    String?  @map("relay_description") @db.Text
  /// Canonical `media_id` order overlay; empty ⇒ inherit ingest order from applicable `PostVersion.mediaIds`.
  mediaOrder          String[] @default([]) @map("media_order")
  /// Inspect-style tier preview / CTA JSON keyed by `relay_tier_id` (structure owned by merge + API layers).
  tierPreviewSettings Json?    @map("tier_preview_settings")
  /// Soft pointer to a creator-owned staging/export media used as the Audience & Promotion teaser.
  /// Not part of `media_order` / canonical `PostVersion.mediaIds`; clearing never deletes the MediaAsset.
  promoPreviewMediaId String?  @map("promo_preview_media_id")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([creatorId])
  @@index([creatorId, postId])
  @@map("post_presentations")
}

/// Creator-supplied Patreon discount codes (Relay does not create Patreon coupons).
/// Codes are normalized uppercase; uniqueness is per creator.
model CreatorPatreonDiscountCode {
  id         String   @id @default(cuid())
  creatorId  String   @map("creator_id")
  /// Optional human label (e.g. "Launch week").
  label      String?
  /// Normalized uppercase code string as entered by the creator.
  code       String
  percentOff Int      @map("percent_off")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  offers                PostMarketingOffer[]
  tierPromotionDefaults CreatorTierPromotionDefault[]

  @@unique([creatorId, code])
  @@index([creatorId])
  @@map("creator_patreon_discount_codes")
}

/// Live default promo for locked (unpermissioned) viewers on posts gated at a minimum Relay tier.
/// Future posts and tier changes inherit by matching the post's normalized minimum gate — not bulk-copied.
model CreatorTierPromotionDefault {
  id                    String   @id @default(cuid())
  creatorId             String   @map("creator_id")
  /// Relay tier id for the post's minimum Patreon gate floor.
  gateRelayTierId       String   @map("gate_relay_tier_id")
  /// Audience segment; Slice 9 uses `unpermissioned` only (anonymous + below-tier).
  segment               String   @default("unpermissioned")
  discountCodeId        String?  @map("discount_code_id")
  headline              String   @default("")
  ctaText               String   @default("") @map("cta_text")
  /// Optional creator-confirmed HTTPS Patreon destination URL.
  patreonDestinationUrl String?  @map("patreon_destination_url")
  /// Opaque immutable public redirect token (`/go/:slug`). Minted once; never rewritten.
  redirectSlug          String?  @unique @map("redirect_slug")
  /// Opaque Goal Cycle campaign key for attribution (VS4). Does not grant content access.
  goalCycleCampaignKey  String?  @map("goal_cycle_campaign_key")
  active                Boolean  @default(true)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  discountCode CreatorPatreonDiscountCode?      @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  clickEvents  MarketingTierDefaultClickEvent[]

  @@unique([creatorId, gateRelayTierId, segment])
  @@index([creatorId])
  @@index([goalCycleCampaignKey])
  @@map("creator_tier_promotion_defaults")
}

/// Privacy-minimized click log for tier-default tracked redirects (Slice 9).
model MarketingTierDefaultClickEvent {
  id            String   @id @default(cuid())
  tierDefaultId String   @map("tier_default_id")
  creatorId     String   @map("creator_id")
  occurredAt    DateTime @default(now()) @map("occurred_at")
  referrerHost  String?  @map("referrer_host")

  tierDefault CreatorTierPromotionDefault @relation(fields: [tierDefaultId], references: [id], onDelete: Cascade)

  @@index([tierDefaultId, occurredAt])
  @@index([creatorId, occurredAt])
  @@map("marketing_tier_default_click_events")
}

/// One marketing offer assignment per post + audience persona key.
/// Soft-links discount codes (`onDelete: SetNull`) so deactivating/deleting a code leaves the offer recoverable.
model PostMarketingOffer {
  id                    String   @id @default(cuid())
  creatorId             String   @map("creator_id")
  postId                String   @map("post_id")
  /// `anonymous` or `tier:${relayTierId}` — see audience-promotion contracts.
  audienceKey           String   @map("audience_key")
  discountCodeId        String?  @map("discount_code_id")
  headline              String   @default("")
  ctaText               String   @default("") @map("cta_text")
  /// Optional creator-confirmed HTTPS Patreon destination URL.
  patreonDestinationUrl String?  @map("patreon_destination_url")
  /// Opaque immutable public redirect token (`/go/:slug`). Minted once; never rewritten.
  redirectSlug          String?  @unique @map("redirect_slug")
  /// Opaque Goal Cycle campaign key for attribution (VS4). Does not grant content access.
  goalCycleCampaignKey  String?  @map("goal_cycle_campaign_key")
  active                Boolean  @default(true)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  post         Post                        @relation(fields: [postId], references: [id], onDelete: Cascade)
  discountCode CreatorPatreonDiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  clickEvents  MarketingOfferClickEvent[]

  @@unique([creatorId, postId, audienceKey])
  @@index([creatorId])
  @@index([creatorId, postId])
  @@index([goalCycleCampaignKey])
  @@map("post_marketing_offers")
}

/// Privacy-minimized click log for tracked offer redirects (Slice 7).
model MarketingOfferClickEvent {
  id           String   @id @default(cuid())
  offerId      String   @map("offer_id")
  creatorId    String   @map("creator_id")
  postId       String   @map("post_id")
