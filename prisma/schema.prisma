  dimensions      Json     @default("{}")
  sourceFreshness Json     @default("{}") @map("source_freshness")
  generatedAt     DateTime @default(now()) @map("generated_at")

  @@unique([metricKey, dayUtc, scope, scopeId])
  @@index([metricKey, dayUtc])
  @@index([dayUtc])
  @@index([scope, scopeId, dayUtc])
  @@map("platform_metric_daily_rollups")
}

