  referrerHost String?  @map("referrer_host")

  offer PostMarketingOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, occurredAt])
  @@index([creatorId, occurredAt])
  @@map("marketing_offer_click_events")
}

