// Relay — PostgreSQL via Prisma (see root `.env.example` DATABASE_URL).
// M2: identity · M3: canonical · M4: creator curation (`docs/database/relational-model.md`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Identity & multi-tenancy (M2.1) ---

/// In-app role for rows in `users` (creator/staff). Patron authorization uses `TenantMembership` + `TenantRole`.
enum UserKind {
  creator
  staff
}

/// Per-tenant role for an `Account` (Option B — Multi Tenant Changes).
enum TenantRole {
  patron
}

enum ProviderKind {
  patreon
  subscribestar
}

enum OAuthPurpose {
  creator_ingest
  patron_entitlement
}

/// Durable Patreon OAuth authorize/exchange transaction (Unified Relay Identity).
enum OAuthTransactionPurpose {
  patron_link
  creator_ingest
}

enum OAuthTransactionStatus {
  pending
  in_progress
  completed
  failed
}

enum IdentityAuditOutcome {
  already_correct
  safe_claim
  conflict
  insufficient_proof
  dry_run
}

enum CredentialHealth {
  healthy
  degraded
  invalid
  revoked
}

/// Part 3 K/L — how a `PatronEntitlementSnapshot` was produced (M9 stub).
enum EntitlementSource {
  oauth_exchange
  scheduled_refresh
  webhook
  manual_support
}

/// Part 3 O — comment moderation (M9 stub). PE-E (BO-P2-03) keeps the same three states; auto-mod transitions "visible -> hidden" without removing.
enum CommentModState {
  visible
  hidden
  removed
}

/// PE-E (D12) — who is allowed to see a comment when the post itself is visible to the viewer.
/// Tier requirement on the comment is layered on TOP of this via Comment.requiredTierId (NOT replacing post-level gating).
enum CommentVisibility {
  everyone
  patrons_only
}

/// PE-E — surface a comment-driven content report points at.
enum ContentReportTargetKind {
  comment
  post
  account
}

/// PE-E — lifecycle for ContentReport rows.
enum ContentReportStatus {
  open
  dismissed
  actioned
}

/// PE-E — actor that produced a ModerationAction row.
enum ModerationActorKind {
  creator
  admin
  system_auto_mod
  patron_self
}

/// PE-E — what surface a ModerationAction was applied to.
enum ModerationTargetKind {
  comment
  post
  account
}

/// PE-E — kinds of moderation actions logged. Append-only audit trail; reversible actions log a paired entry rather than mutating the original log row.
enum ModerationActionKind {
  comment_hide
  comment_unhide
  comment_remove
  comment_restore
  comment_pin
  comment_unpin
  comment_tag_revoke
  comment_tag_unrevoke
  account_block
  account_unblock
  report_dismiss
  report_action
  auto_mod_flag
}

/// PE-E (D12) — types of reactions on a comment (small fixed set; expand cautiously to keep aggregation cheap).
enum CommentReactionKind {
  like
  heart
  insightful
  laugh
}

/// PE-C — audit row when patron creator-follows are seeded (OAuth or worker).
/// How `CreatorProfile.publicSlug` was chosen (automation vs user).
enum PublicSlugSource {
  allocated
  patreon_default
  user_chosen
}

enum PatronFollowSeedSource {
  oauth_unified
  oauth_creator_scoped_exchange
  initial_follow_worker
}

/// Mirrors `UserAccount.auth_provider` in `src/identity/types.ts` (independent email/password vs Patreon-linked).
enum IdentityAuthProvider {
  independent
  patreon
}

/// Web (`relay_session` / Bearer) vs browser extension opaque grant (sliding 30d TTL).
enum SessionKind {
  web       @map("web")
  extension @map("extension")
}

model Tenant {
  id             String   @id @default(cuid())
  /// Relay `creator_id` (e.g. ingest / gallery scope) — unique tenant for DbIdentityStore.
  relayCreatorId String?  @unique @map("relay_creator_id")
  createdAt      DateTime @default(now()) @map("created_at")

  users          User[]
  memberships    TenantMembership[]
  creators       CreatorProfile[]
  /// At most one `Account` may claim this tenant as its primary artist studio (MT-031).
  primaryAccount Account?           @relation("AccountPrimaryStudio")
  /// M1-lite / P7 — append-only usage metering (`docs/database/usage-events-rollups.md`).
  usageEvents    UsageEvent[]

  @@map("tenants")
}

/// P7 M1-lite — append-only per-tenant (or unattributed) usage events for metering and rollups.
model UsageEvent {
  id         String   @id @default(cuid())
  tenantId   String?  @map("tenant_id")
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  metric     String
  /// Whole units (e.g. bytes transferred, or 1 for discrete events). See `meta` for detail.
  quantity   BigInt   @default(1) @map("quantity")
  meta       Json?    @map("meta")
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([tenantId, occurredAt])
  @@index([metric, occurredAt])
  @@map("usage_events")
}

/// Global login identity — one person per row (Option B). Patrons are scoped per creator via `TenantMembership`.
model Account {
  id                    String               @id @default(cuid())
  emailHash             String?              @map("email_hash")
  /// Global normalized email (unique when set) — `DbIdentityStore.findByEmail` uses this + `TenantMembership`.
  emailNorm             String?              @unique @map("email_norm")
  passwordHash          String?              @map("password_hash")
  identityAuthProvider  IdentityAuthProvider @map("identity_auth_provider")
  /// Global Patreon user id when linked (unique when set).
  patronPatreonUserId   String?              @unique @map("patron_patreon_user_id")
  /// Supabase Auth `auth.users.id` (Pattern A, ADR 001). Null until linked (MIG-11+).
  supabaseUserId        String?              @unique @map("supabase_user_id") @db.Uuid
  /// Artist studio scope — matches `Tenant.relayCreatorId` when this account owns a creator workspace (MT-031). Null for patron-only accounts.
  primaryRelayCreatorId String?              @unique @map("primary_relay_creator_id")
  /// Canonical public Relay username. This is the account's one @mention alias across creator and supporter surfaces.
  username              String?
  /// Lowercase normalized Relay username for global uniqueness.
  usernameNorm          String?              @unique @map("username_norm")
  /// Backfill trace: stable id from `identity.json` / file store era (see integration-roadmap 2.3.x).
  legacyFileId          String?              @map("legacy_file_id")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  memberships                        TenantMembership[]
  patronOAuthCredential              PatronOAuthCredential?
  /// SubscribeStar subscriber OAuth — distinct from Patreon `PatronOAuthCredential` so both links can coexist.
  patronSubscribestarOAuthCredential PatronSubscribestarOAuthCredential?
  primaryStudio                      Tenant?                             @relation("AccountPrimaryStudio", fields: [primaryRelayCreatorId], references: [relayCreatorId], onDelete: SetNull, onUpdate: Cascade)
  followsOutgoing                    AccountFollow[]                     @relation("AccountFollowsOutgoing")
  followsIncoming                    AccountFollow[]                     @relation("AccountFollowsIncoming")
  discordLinkTokens                  DiscordLinkToken[]
  discordBindingsLinked              DiscordChannelBinding[]             @relation("DiscordChannelBindingLinker")
  creatorNotifications               Notification[]                      @relation("CreatorNotificationRecipient")
  oauthTransactions                  OAuthTransaction[]
  identityAuditEvents                IdentityAuditEvent[]

  @@map("accounts")
}

/// Per-tenant membership for an `Account` (tier entitlements, patron sessions, etc.).
model TenantMembership {
  id           String     @id @default(cuid())
  accountId    String     @map("account_id")
  account      Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tenantId     String     @map("tenant_id")
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role         TenantRole @default(patron)
  tierIds      String[]   @default([]) @map("tier_ids")
  legacyFileId String?    @map("legacy_file_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  sessions                    Session[]
  patronProfile               PatronProfile?
  patronFollows               PatronFollow[]
  patronEntitlementSnapshots  PatronEntitlementSnapshot[]
  patronCampaignAccessRecords PatronCampaignAccess[]
  feedCursors                 FeedCursor[]
  notificationPreferences     NotificationPreference[]
  notifications               Notification[]
  patronFollowSeeds           PatronFollowSeed[]
  notificationDigestRuns      NotificationDigestRun[]

  @@unique([accountId, tenantId])
  @@index([tenantId])
  @@map("tenant_memberships")
}

/// Creator/staff rows only — patron identity is `Account` + `TenantMembership`.
model User {
  id                   String               @id @default(cuid())
  tenantId             String               @map("tenant_id")
  tenant               Tenant               @relation(fields: [tenantId], references: [id])
  kind                 UserKind
  identityAuthProvider IdentityAuthProvider @map("identity_auth_provider")
  tierIds              String[]             @default([]) @map("tier_ids")
  /// Backfill trace for creator rows when applicable.
  legacyFileId         String?              @map("legacy_file_id")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  providerAccounts ProviderAccount[]
  creatorProfile   CreatorProfile?

  @@index([tenantId, kind])
  @@map("users")
}

model Session {
  id                 String           @id @default(cuid())
  tenantMembershipId String           @map("tenant_membership_id")
  tenantMembership   TenantMembership @relation(fields: [tenantMembershipId], references: [id], onDelete: Cascade)
  /// SHA-256 (or app-defined hash) of opaque token only — never store raw tokens (operations-and-security.md).
  tokenHash          String           @unique @map("token_hash")
  /// Backfill trace for file-backed sessions (integration-roadmap 2.3.x).
  legacyFileId       String?          @map("legacy_file_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  expiresAt          DateTime?        @map("expires_at")
  userAgent          String?          @map("user_agent")
  ipInet             String?          @map("ip_inet")
  revokedAt          DateTime?        @map("revoked_at")
  kind               SessionKind      @default(web) @map("kind")
  /// User-visible label (e.g. extension install + UA), set on extension issue.
  label              String?          @map("label")
  /// Sliding-window anchor for extension grants (`touchSessionExpiry`).
  lastUsedAt         DateTime?        @map("last_used_at")

  @@index([tenantMembershipId, kind, expiresAt])
  @@map("sessions")
}

model ProviderAccount {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       ProviderKind
  providerUserId String       @map("provider_user_id")
  displayName    String?      @map("display_name")
  createdAt      DateTime     @default(now()) @map("created_at")

  oauthCredential OAuthCredential?

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("provider_accounts")
}

model OAuthCredential {
  id                String           @id @default(cuid())
  providerAccountId String           @unique @map("provider_account_id")
  providerAccount   ProviderAccount  @relation(fields: [providerAccountId], references: [id], onDelete: Cascade)
  purpose           OAuthPurpose
  encryptedPayload  Bytes            @map("encrypted_payload")
  keyId             String           @map("key_id")
  healthStatus      CredentialHealth @map("health_status")
  lastSuccessAt     DateTime?        @map("last_success_at")
  lastFailureAt     DateTime?        @map("last_failure_at")
  lastFailureCode   String?          @map("last_failure_code")
  expiresAtHint     DateTime?        @map("expires_at_hint")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@map("oauth_credentials")
}

model CreatorProfile {
  id                              String           @id @default(cuid())
  tenantId                        String           @map("tenant_id")
  tenant                          Tenant           @relation(fields: [tenantId], references: [id])
  userId                          String           @unique @map("user_id")
  user                            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Public URL segment for `/patron/c/{public_slug}` — unique, lowercase, `[a-z0-9-]`.
  publicSlug                      String           @unique @map("public_slug")
  /// Provenance for `publicSlug`: opaque default, Patreon campaign vanity, or explicit user edit.
  slugSource                      PublicSlugSource @default(allocated) @map("slug_source")
  /// Canonical Patreon `campaign_id` for this creator (ingest / webhooks / patron matching). See `docs/architecture/multi-tenant-option-b.md`.
  patreonCampaignId               String?          @unique @map("patreon_campaign_id")
  /// Canonical SubscribeStar creator/profile id for creator-side ingest and patron matching.
  subscribestarProfileId          String?          @unique @map("subscribestar_profile_id")
  /// Opaque JSON: merged supplemental SubscribeStar GraphQL `data` roots (e.g. subscriptions/payments operations) from last ingest.
  subscribestarProviderSnapshot   Json?            @map("subscribestar_provider_snapshot")
  subscribestarProviderSnapshotAt DateTime?        @map("subscribestar_provider_snapshot_at")
  /// Mutable public @handle (mixed case allowed); uniqueness is on `usernameNorm`.
  username                        String?
  /// Lowercase normalized username for uniqueness; mirrors `PatronProfile.handleNorm` pattern.
  usernameNorm                    String?          @unique @map("username_norm")
  displayName                     String?          @map("display_name")
  avatarUrl                       String?          @map("avatar_url")
  bannerUrl                       String?          @map("banner_url")
  /// Short bio, capped at 280 chars by the service layer.
  bio                             String?
  /// Free-text creative discipline (e.g. "Digital Illustrator"), rendered in feed cards.
  discipline                      String?
  createdAt                       DateTime         @default(now()) @map("created_at")
  updatedAt                       DateTime         @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([patreonCampaignId])
  @@index([subscribestarProfileId])
  @@map("creator_profiles")
}

model PatronProfile {
  id                         String           @id @default(cuid())
  tenantMembershipId         String           @unique @map("tenant_membership_id")
  tenantMembership           TenantMembership @relation(fields: [tenantMembershipId], references: [id], onDelete: Cascade)
  /// Display / entry handle (mixed case allowed); uniqueness is on `handleNorm`.
  handle                     String?
  /// Lowercase normalized handle for uniqueness and `/p/[handle]` (D16).
  handleNorm                 String?          @unique @map("handle_norm")
  displayName                String?          @map("display_name")
  bio                        String?
  avatarUrl                  String?          @map("avatar_url")
  bannerUrl                  String?          @map("banner_url")
  /// Default false until the patron opts into a public presence (D16).
  isPublic                   Boolean          @default(false) @map("is_public")
  /// Onboarding wizard progress 0–4 (PE-A skeleton).
  onboardingStep             Int              @default(0) @map("onboarding_step")
  /// When true, creator update alerts batch into a digest instead of instant pings.
  notificationDigestEnabled  Boolean          @default(true) @map("notification_digest_enabled")
  /// Digest cadence slug: weekly | monthly.
  notificationDigestCadence  String           @default("weekly") @map("notification_digest_cadence")
  /// Browse window slug: morning | midday | evening | late_night.
  notificationDigestSlot     String?          @map("notification_digest_slot")
  /// IANA timezone for browse-window scheduling (e.g. America/New_York). Null → UTC.
  notificationDigestTimezone String?          @map("notification_digest_timezone")
  /// When true, patron feed/search/notifications omit posts rated Adult (18+).
  hideMatureContent          Boolean          @default(false) @map("hide_mature_content")
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")

  @@map("patron_profiles")
}

/// PE-G digest — idempotent email batch record per patron + digest period.
enum NotificationDigestRunStatus {
  sent
  skipped
  failed
}

model NotificationDigestRun {
  id                 String                      @id @default(cuid())
  patronMembershipId String                      @map("patron_membership_id")
  membership         TenantMembership            @relation(fields: [patronMembershipId], references: [id], onDelete: Cascade)
  cadence            String
  slot               String
  periodStart        DateTime                    @map("period_start")
  periodEnd          DateTime                    @map("period_end")
  status             NotificationDigestRunStatus
  itemCount          Int                         @default(0) @map("item_count")
  payloadJson        Json                        @default("{}") @map("payload_json")
  providerMessageId  String?                     @map("provider_message_id")
  errorMessage       String?                     @map("error_message")
  sentAt             DateTime?                   @map("sent_at")
  createdAt          DateTime                    @default(now()) @map("created_at")

  @@unique([patronMembershipId, cadence, periodStart])
  @@index([patronMembershipId, sentAt(sort: Desc)])
  @@map("notification_digest_runs")
}

// --- Canonical ingest + gallery (M3 Phase 3.1) — string `creator_id` matches Relay ingest scope (see `canonical-store.ts`) ---

enum PostUpstreamStatus {
  active
  deleted
}

enum MediaUpstreamStatus {
  active
  deleted
}

/// Origin of a `Post` row: mirrored from Patreon vs created in Relay.
enum PostSource {
  PATREON
  SUBSCRIBESTAR
  RELAY
}

/// Publish lifecycle for Relay-owned posts (VS7). Patreon/SS mirrors default to `published`.
/// Goal Cycle / rail drafts use `draft` with nullable `PostVersion.publishedAt`.
enum PostPublishState {
  draft
  published
}

/// How a `MediaAsset` was first ingested: upstream sync vs direct Relay upload vs Discord capture.
enum MediaIngestOrigin {
  PATREON
  SUBSCRIBESTAR
  RELAY_UPLOAD
  DISCORD
}

/// Relay direct-upload pipeline visibility (creator UI); Patreon-ingested rows stay READY.
enum MediaProcessingStatus {
  PENDING_UPLOAD
  UPLOADED
  READY
  FAILED
}

/// Patreon (or mapped) campaign row — `id` is stable `campaign_id` from `CampaignRow` / ingest.
model Campaign {
  id                String   @id
  creatorId         String   @map("creator_id")
  name              String
  upstreamUpdatedAt DateTime @map("upstream_updated_at")
  versionSeq        Int      @map("version_seq")

  posts Post[]
  tiers Tier[]

  @@index([creatorId])
  @@map("campaigns")
}

/// Access tier — `id` is a stable synthetic key (e.g. `${creator_id}::${relay_tier_id}`) because relay tier keys repeat across creators.
model Tier {
  id                            String    @id @map("id")
  creatorId                     String    @map("creator_id")
  /// File / API tier key (`TierRow.tier_id`), e.g. `patreon_tier_123`, `RELAY_TIER_PUBLIC`.
  relayTierId                   String    @map("relay_tier_id")
  /// Opaque provider id for idempotency (Patreon tier id or same as `relay_tier_id` when unknown).
  providerTierId                String    @map("provider_tier_id")
  /// When this row is a `relay_manual_tier_*` folder, optional canonical provider-access key uploads must match (`patreon_tier_*` / `substar_tier_*`).
  manualUploadAccessRelayTierId String?   @map("manual_upload_access_relay_tier_id")
  campaignId                    String?   @map("campaign_id")
  campaign                      Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  title                         String
  amountCents                   Int?      @map("amount_cents")
  upstreamUpdatedAt             DateTime  @map("upstream_updated_at")
  versionSeq                    Int       @map("version_seq")

  postTiers PostTier[]

  @@unique([creatorId, providerTierId])
  @@index([creatorId])
  @@map("tiers")
}

/// Post — `id` is stable `post_id` from `PostRow` / ingest.
model Post {
  id             String             @id @map("id")
  campaignId     String             @map("campaign_id")
  campaign       Campaign           @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  creatorId      String             @map("creator_id")
  /// Opaque idempotency key from upstream when known. **PATREON** ingest sets this to the same
  /// value as `id` (stable `post_id` in snapshot, e.g. `patreon_post_…`) so `@@unique([campaignId, providerPostId])` applies.
  /// **RELAY** native posts: keep `null`; uniqueness is the primary key `id` (e.g. cuid). PG allows many `(campaign_id, null)` rows.
  providerPostId String?            @map("provider_post_id")
  upstreamStatus PostUpstreamStatus @map("upstream_status")
  /// Gallery / feed ordering — set from ingest (e.g. earliest `published_at` in versions).
  createdAt      DateTime           @map("created_at")
  /// Tier 1 RLS — when true, post is readable without tier membership (anon + any logged-in user).
  isPublic       Boolean            @default(false) @map("is_public")
  /// Tier 1 RLS — patrons must have this tier id in `TenantMembership.tier_ids` when not public; null with `is_public` false = creator-only (draft).
  requiredTierId String?            @map("required_tier_id")
  /// Patreon sync only mutates `PATREON`; Relay-native posts use `RELAY` and are out of sync blast radius.
  source         PostSource         @default(PATREON) @map("source")
  /// VS7 — planned Goal Cycle / rail drafts are `draft`; creator-confirmed publish → `published`.
  /// Existing rows backfilled to `published`. Monthly posting-goal counts exclude `draft`.
  publishState   PostPublishState   @default(published) @map("publish_state")

  versions                    PostVersion[]
  postTiers                   PostTier[]
  mediaAssets                 MediaAsset[]
  /// Creator-controlled presentation overlays (titles, descriptions, ordering, tier previews).
  /// Merged at read time with append-only ingest (`PostVersion`); ingest must not mutate this row.
  presentation                PostPresentation?
  /// P5a — Patreon Insights CSV rows linked when `patreon_post_id` matches `id` or `provider_post_id`.
  patreonInsightsPostMetrics  PatreonInsightsPostMetric[]
  relayEngagementEvents       RelayEngagementEvent[]
  distributionPlans           PostDistributionPlan[]
  externalPostMetricSnapshots ExternalPostMetricSnapshot[]
  creativeWorkMember          CreativeWorkMember?
  platformInstances           PlatformInstance[]
  /// Audience & Promotion — per-persona marketing offers (Slice 4).
  marketingOffers             PostMarketingOffer[]
  /// Manual Schedule Rail social events (URL-only or post-linked).
  creatorScheduleEvents       CreatorScheduleEvent[]

  @@unique([campaignId, providerPostId])
  @@index([campaignId, createdAt(sort: Desc)])
  @@index([creatorId, source])
  @@index([creatorId, publishState])
  @@map("posts")
}

model PostVersion {
  id               String    @id @default(cuid())
  postId           String    @map("post_id")
  post             Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  versionSeq       Int       @map("version_seq")
  upstreamRevision String    @map("upstream_revision")
  title            String
  description      String?
  /// Null while `Post.publishState = draft`. Never use epoch/future timestamps as draft sentinels.
  publishedAt      DateTime? @map("published_at")
  tagIds           String[]  @default([]) @map("tag_ids")
  tierIds          String[]  @default([]) @map("tier_ids")
  mediaIds         String[]  @default([]) @map("media_ids")
  ingestedAt       DateTime  @map("ingested_at")

  @@unique([postId, versionSeq])
  @@index([postId])
  @@map("post_versions")
}

/// Media — `id` is stable `media_id` from `MediaRow`. `primary_post_id` indexes the canonical post link; `post_ids` mirrors file M:N.
model MediaAsset {
  id                      String                 @id @map("id")
  creatorId               String                 @map("creator_id")
  postIds                 String[]               @default([]) @map("post_ids")
  /// Set after attach to a `Post` (Patreon ingest or Relay publish). Null while upload-only (T-3.2) or if post was deleted.
  primaryPostId           String?                @map("primary_post_id")
  post                    Post?                  @relation(fields: [primaryPostId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  upstreamStatus          MediaUpstreamStatus    @map("upstream_status")
  currentVersionSeq       Int                    @map("current_version_seq")
  currentUpstreamRevision String                 @map("current_upstream_revision")
  currentMimeType         String?                @map("current_mime_type")
  currentUpstreamUrl      String?                @map("current_upstream_url")
  currentRole             String?                @map("current_role")
  /// Object key under tenant storage (e.g. export `media/{id}/asset` or future R2 key). Not a public premium CDN URL.
  currentStorageKey       String?                @map("current_storage_key")
  currentIngestedAt       DateTime               @map("current_ingested_at")
  versionsJson            Json                   @map("versions_json")
  /// Patreon sync / export path vs future direct upload; default PATREON for legacy rows.
  ingestOrigin            MediaIngestOrigin      @default(PATREON) @map("ingest_origin")
  processingStatus        MediaProcessingStatus  @default(READY) @map("processing_status")
  processingError         String?                @map("processing_error")
  /// Discord-only: message/channel/attachment snowflakes and caption snapshot (see Phase 1 Discord capture).
  discordCaptureJson      Json?                  @map("discord_capture_json")
  /// Coordinate-pinned comments referencing this asset (`Comment.media_id`).
  commentPins             Comment[]
  discordIngestReceipt    DiscordMediaIngestKey?
  relayEngagementEvents   RelayEngagementEvent[]
  /// Manual Import: staged uploads carry intended provider access (`v:1`) before compose/publish (`primaryPostId` null).
  manualImportStagingJson Json?                  @map("manual_import_staging_json")
  /// Autopost WI-2 — reserved by an active studio draft (excluded from staging bin).
  autopostDraftId         String?                @map("autopost_draft_id")
  autopostDraft           AutopostDraft?         @relation(fields: [autopostDraftId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([primaryPostId])
  @@index([creatorId, ingestOrigin])
  @@index([autopostDraftId])
  @@map("media_assets")
}

model PostTier {
  postId String @map("post_id")
  tierId String @map("tier_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tier   Tier   @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@id([postId, tierId])
  @@map("post_tiers")
}

/// Replaces file-backed `SyncWatermarkStore` (`last_synced_at` per creator + campaign).
model SyncCursor {
  creatorId    String   @map("creator_id")
  campaignId   String   @map("campaign_id")
  lastSyncedAt DateTime @map("last_synced_at")
  updatedAt    DateTime @map("updated_at")

  @@id([creatorId, campaignId])
  @@map("sync_cursors")
}

/// Replaces file-backed `PatreonSyncHealthStore` (`last_post_scrape` / `last_member_sync` JSON blobs).
model CreatorSyncState {
  creatorId      String   @id @map("creator_id")
  lastPostScrape Json?    @map("last_post_scrape")
  lastMemberSync Json?    @map("last_member_sync")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("creator_sync_states")
}

/// Provider-scoped sync snapshots keep Patreon and SubscribeStar health independent.
model CreatorProviderSyncState {
  creatorId      String       @map("creator_id")
  provider       ProviderKind
  lastPostSync   Json?        @map("last_post_sync")
  lastMemberSync Json?        @map("last_member_sync")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@id([creatorId, provider])
  @@map("creator_provider_sync_states")
}

/// P4-onb-001 — Part 1-A creator funnel: Connect Patreon → Import → Organize → Publish (persisted step + optional JSON metadata).
enum CreatorOnboardingStep {
  /// Patreon linked; backfill default for existing creators before finer-grained transitions ship.
  connected
  /// Initial import path entered (e.g. after creator OAuth success — P4-onb-004).
  import_started
  /// Library / organize phase acknowledged (P4-onb-005).
  organized
  /// Public gallery has been published at least once.
  published
}

/// One row per Relay `creator_id` (ingest scope; aligns with `Campaign.creatorId` / `CreatorSyncState`).
model CreatorOnboardingState {
  creatorId String                @id @map("creator_id")
  step      CreatorOnboardingStep @default(connected) @map("step")
  /// Small JSON only (flags, timestamps); no PII — service layer enforces shape.
  metadata  Json?                 @map("metadata")
  updatedAt DateTime              @updatedAt @map("updated_at")

  @@map("creator_onboarding_states")
}

/// Replaces `ingest_idempotency` map in `canonical.json` — `batch_key` is the SHA-256 hex from `ingestIdempotencyKey()`.
model IngestIdempotencyKey {
  id          String   @id @default(cuid())
  creatorId   String   @map("creator_id")
  batchKey    String   @map("batch_key")
  firstSeenAt DateTime @map("first_seen_at")

  @@unique([creatorId, batchKey])
  @@index([creatorId])
  @@map("ingest_idempotency_keys")
}

// --- Creator curation (M4 Phase 4.1) — Relay `creator_id` scope strings; no FK to `CreatorProfile` (see canonical pattern). ---

enum GalleryVisibility {
  visible
  hidden
  review
}

/// Creator Step 5 review picks either a full post or a single media asset.
enum CreatorPromoSlotTargetKind {
  post
  media
}

/// Step 5 "Review Library" picks (1-5 ranked promo entries) for a creator studio.
model CreatorPromoSlot {
  id          String                     @id @default(cuid())
  creatorId   String                     @map("creator_id")
  slotRank    Int                        @map("slot_rank")
  targetKind  CreatorPromoSlotTargetKind @map("target_kind")
  targetId    String                     @map("target_id")
  label       String?
  metadata    Json?                      @map("metadata")
  /// Tip beta (MB-5+): when false, piece is never Tip-eligible regardless of other rules.
  tipEligible Boolean                    @default(true) @map("tip_eligible")
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")

  @@unique([creatorId, slotRank])
  @@index([creatorId])
  @@map("creator_promo_slots")
}

/// Autopost WI-3 — saved voice/tone for AI draft generation (one default profile per creator).
model CreatorStyleProfile {
  id          String   @id @default(cuid())
  creatorId   String   @map("creator_id")
  label       String   @default("Default")
  isDefault   Boolean  @default(true) @map("is_default")
  /// none | friendly | professional | warm | playful | formal
  tonePreset  String   @default("friendly") @map("tone_preset")
  /// Optional artist-authored details or raw wording for the LLM to clean up.
  userPrompt  String?  @map("user_prompt") @db.Text
  /// Resolved voice script stored for audit/replay (preset sample + user prompt).
  voiceScript String   @default("") @map("voice_script") @db.Text
  settings    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  autopostDrafts AutopostDraft[]

  @@unique([creatorId, label])
  @@index([creatorId, isDefault])
  @@map("creator_style_profiles")
}

/// Autopost WI-2 — creator-only preview workspace before Relay publish.
/// `nudged` rows are reserved for goal-driven slots (may have empty media_ids).
model AutopostDraft {
  id                String               @id @default(cuid())
  creatorId         String               @map("creator_id")
  /// nudged | drafting | previewing | published | discarded
  status            String               @default("drafting")
  mediaIds          String[]             @default([]) @map("media_ids")
  title             String?
  bodyText          String?              @map("body_text") @db.Text
  styleProfileId    String?              @map("style_profile_id")
  styleProfile      CreatorStyleProfile? @relation(fields: [styleProfileId], references: [id], onDelete: SetNull)
  /// Short label e.g. "June continuation #1" (goal/PostBot slots).
  intent            String?
  /// Optional CreatorPerformanceGoal id (no FK in v1).
  performanceGoalId String?              @map("performance_goal_id")
  /// pick-media | draft-post | variation-planning | variant-review | cross-post | complete
  composerStep      String               @default("pick-media") @map("composer_step")
  /// { selected_destinations?, tags?, tier_ids?, is_public?, campaign_id?, needs_preview? }
  workspace         Json                 @default("{}")
  enhancements      Json                 @default("{}")
  /// Cross-post destinations already attempted (for discard warning). e.g. { "patreon": "2026-06-28T…" }
  distributionLog   Json                 @default("{}") @map("distribution_log")
  publishedPostId   String?              @map("published_post_id")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  reservedMedia     MediaAsset[]
  distributionPlans PostDistributionPlan[]

  @@index([creatorId, status])
  @@map("autopost_drafts")
}

/// Post-level distribution plan — platform relay strategy after canonical Relay publish.
model PostDistributionPlan {
  id                   String         @id @default(cuid())
  creatorId            String         @map("creator_id")
  postId               String         @map("post_id")
  post                 Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  sourceDraftId        String?        @map("source_draft_id")
  sourceDraft          AutopostDraft? @relation(fields: [sourceDraftId], references: [id], onDelete: SetNull)
  /// active | completed | archived
  status               String         @default("active")
  /// none | requested | completed | skipped | failed
  assistantMode        String         @default("none") @map("assistant_mode")
  assistantContext     Json           @default("{}") @map("assistant_context")
  assistantPlan        Json           @default("{}") @map("assistant_plan")
  /// Opaque Goal Cycle campaign key (VS4). Nullable for legacy plans.
  goalCycleCampaignKey String?        @map("goal_cycle_campaign_key")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  variants     PostDistributionVariant[]
  postbotTasks PostbotTask[]

  @@index([creatorId, status])
  @@index([postId, status])
  @@index([goalCycleCampaignKey])
  @@map("post_distribution_plans")
}

/// Platform-specific variant for a distribution plan.
model PostDistributionVariant {
  id                   String               @id @default(cuid())
  planId               String               @map("plan_id")
  plan                 PostDistributionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  postId               String               @map("post_id")
  creatorId            String               @map("creator_id")
  /// patreon | x | deviantart | bluesky
  destination          String
  /// draft | approved | handed_off | fill_failed | posted | failed | skipped
  status               String               @default("draft")
  assistantEnabled     Boolean              @default(false) @map("assistant_enabled")
  title                String?
  bodyText             String?              @map("body_text") @db.Text
  postText             String?              @map("post_text") @db.Text
  tags                 String[]             @default([])
  locale               String?
  scheduledFor         DateTime?            @map("scheduled_for")
  /// Opt-in: ping the creator (in-app notification) when scheduledFor arrives.
  remindMe             Boolean              @default(false) @map("remind_me")
  reminderSentAt       DateTime?            @map("reminder_sent_at")
  platformFields       Json                 @default("{}") @map("platform_fields")
  advice               Json                 @default("{}")
  approvedAt           DateTime?            @map("approved_at")
  /// Opaque Goal Cycle campaign key (VS4). Nullable for legacy variants.
  goalCycleCampaignKey String?              @map("goal_cycle_campaign_key")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  attempts     PostDistributionAttempt[]
  postbotTasks PostbotTask[]

  @@unique([planId, destination])
  @@index([postId, destination])
  @@index([creatorId, status])
  @@index([goalCycleCampaignKey])
  @@map("post_distribution_variants")
}

/// Handoff attempt for a distribution variant (extension or API publish).
model PostDistributionAttempt {
  id                      String                  @id @default(cuid())
  variantId               String                  @map("variant_id")
  variant                 PostDistributionVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  postId                  String                  @map("post_id")
  creatorId               String                  @map("creator_id")
  destination             String
  /// started | package_fetched | tab_opened | injected | fill_succeeded | fill_partial | fill_failed | posted | abandoned | failed
  status                  String                  @default("started")
  extensionInstallationId String?                 @map("extension_installation_id")
  extensionTabId          Int?                    @map("extension_tab_id")
  fillResult              Json                    @default("{}") @map("fill_result")
  externalUrl             String?                 @map("external_url")
  externalId              String?                 @map("external_id")
  errorCode               String?                 @map("error_code")
  errorDetail             String?                 @map("error_detail") @db.Text
  startedAt               DateTime                @default(now()) @map("started_at")
  completedAt             DateTime?               @map("completed_at")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")

  metricSnapshots  ExternalPostMetricSnapshot[]
  platformInstance PlatformInstance?

  @@index([variantId, status])
  @@index([postId, destination])
  @@index([creatorId, status])
  @@map("post_distribution_attempts")
}

/// Time-series engagement captured from an external post URL (Slice 2).
model ExternalPostMetricSnapshot {
  id                 String                  @id @default(cuid())
  attemptId          String                  @map("attempt_id")
  attempt            PostDistributionAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  platformInstanceId String?                 @map("platform_instance_id")
  platformInstance   PlatformInstance?       @relation(fields: [platformInstanceId], references: [id], onDelete: SetNull)
  postId             String                  @map("post_id")
  post               Post                    @relation(fields: [postId], references: [id], onDelete: Cascade)
  creatorId          String                  @map("creator_id")
  destination        String
  externalUrl        String                  @map("external_url")
  externalId         String?                 @map("external_id")
  /// views | likes | favorites | comments | reposts | quotes | bookmarks | impressions | …
  metricType         String                  @map("metric_type")
  value              Int?
  raw                Json                    @default("{}")
  /// extension_dom | public_scrape | platform_api | manual | third_party
  source             String
  capturedAt         DateTime                @default(now()) @map("captured_at")

  @@index([attemptId, metricType, capturedAt])
  @@index([platformInstanceId, metricType, capturedAt])
  @@index([postId, destination, metricType, capturedAt])
  @@index([creatorId, capturedAt])
  @@map("external_post_metric_snapshots")
}

/// Slice 2d — daily rollup of external post metrics for creator-level analytics.
model ExternalPostMetricDaily {
  id             String   @id @default(cuid())
  creatorId      String   @map("creator_id")
  postId         String   @map("post_id")
  destination    String
  metricType     String   @map("metric_type")
  day            DateTime @map("day") @db.Date
  value          Int      @default(0)
  deltaFromPrior Int?     @map("delta_from_prior")
  /// extension_dom | public_scrape | platform_api | manual | third_party
  source         String
  computedAt     DateTime @default(now()) @map("computed_at")

  @@unique([creatorId, postId, destination, metricType, day])
  @@index([creatorId, day])
  @@index([postId, metricType, day])
  @@map("external_post_metric_daily")
}

/// Performance intelligence — Work/Bundle (one creative work across variants/platforms).
/// @see docs/analytics/PERFORMANCE_INTELLIGENCE_VOCABULARY.md
enum CreativeWorkVariantRole {
  full
  teaser
  promo
  repost
  standalone
}

model CreativeWork {
  id                     String   @id
  creatorId              String   @map("creator_id")
  title                  String
  description            String?  @db.Text
  /// Analytics campaign label (not Patreon `Campaign`).
  analyticsCampaignLabel String?  @map("analytics_campaign_label")
  tags                   String[] @default([])
  /// True when auto-created 1:1 for a single Relay Post (legacy backfill or default on create).
  isDefaultBundle        Boolean  @default(false) @map("is_default_bundle")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  members                   CreativeWorkMember[]
  incomingBundleSuggestions CreativeWorkBundleSuggestionDismissal[] @relation("DismissedTargetWork")

  @@index([creatorId, createdAt(sort: Desc)])
  @@index([creatorId, analyticsCampaignLabel])
  @@map("creative_works")
}

/// Links a Relay Post to a Work/Bundle with a variant role (full, teaser, etc.).
model CreativeWorkMember {
  id             String                  @id
  creativeWorkId String                  @map("creative_work_id")
  creativeWork   CreativeWork            @relation(fields: [creativeWorkId], references: [id], onDelete: Cascade)
  postId         String                  @unique @map("post_id")
  post           Post                    @relation(fields: [postId], references: [id], onDelete: Cascade)
  creatorId      String                  @map("creator_id")
  variantRole    CreativeWorkVariantRole @default(standalone) @map("variant_role")
  /// Optional page / variant label for Linked Sets (e.g. "Page 3", "Teaser").
  memberLabel    String?                 @map("member_label")
  sortOrder      Int                     @default(0) @map("sort_order")
  linkedAt       DateTime                @default(now()) @map("linked_at")

  @@index([creativeWorkId, sortOrder])
  @@index([creatorId])
  @@map("creative_work_members")
}

/// User-dismissed Work/Bundle merge suggestion (never auto-merge).
model CreativeWorkBundleSuggestionDismissal {
  id                   String       @id @default(cuid())
  creatorId            String       @map("creator_id")
  sourcePostId         String       @map("source_post_id")
  targetCreativeWorkId String       @map("target_creative_work_id")
  targetCreativeWork   CreativeWork @relation("DismissedTargetWork", fields: [targetCreativeWorkId], references: [id], onDelete: Cascade)
  dismissedAt          DateTime     @default(now()) @map("dismissed_at")

  @@unique([creatorId, sourcePostId, targetCreativeWorkId])
  @@index([creatorId, dismissedAt(sort: Desc)])
  @@map("creative_work_bundle_suggestion_dismissals")
}

/// Performance intelligence Phase 8 — targeted metric goals (work, campaign, platform, creator).
enum PerformanceGoalScope {
  creator
  work
  campaign
  platform
}

enum PerformanceGoalMetric {
  reach
  likes
  comments
}

model CreatorPerformanceGoal {
  id          String                @id @default(cuid())
  creatorId   String                @map("creator_id")
  scope       PerformanceGoalScope
  /// Work id, analytics campaign label, destination slug, or null for creator-wide.
  scopeRef    String?               @map("scope_ref")
  metric      PerformanceGoalMetric
  targetValue Int                   @map("target_value")
  /// Measurement window: 7d | 30d | 90d
  range       String                @default("30d")
  label       String?
  enabled     Boolean               @default(true)
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  @@index([creatorId, enabled])
  @@index([creatorId, scope, scopeRef])
  @@map("creator_performance_goals")
}

/// Performance intelligence — one published/linkable presence on a destination.
/// @see docs/analytics/PLATFORM_INSTANCE_SCHEMA.md
enum PlatformInstanceLinkSource {
  autopost_success
  manual_url_confirm
  api_identity
  csv_import
  suggested_merge
  inferred_only
  relay_native
}

enum PlatformInstanceStatus {
  active
  unlinked
  stale
}

model PlatformInstance {
  id                           String                     @id
  creatorId                    String                     @map("creator_id")
  postId                       String                     @map("post_id")
  post                         Post                       @relation(fields: [postId], references: [id], onDelete: Cascade)
  destination                  String
  externalUrl                  String?                    @map("external_url")
  externalId                   String?                    @map("external_id")
  attemptId                    String?                    @unique @map("attempt_id")
  attempt                      PostDistributionAttempt?   @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  linkSource                   PlatformInstanceLinkSource @map("link_source")
  status                       PlatformInstanceStatus     @default(active)
  /// conservative | manual_only | disabled — refresh scheduling hint for Phase 4.
  refreshPolicy                String                     @default("conservative") @map("refresh_policy")
  linkedAt                     DateTime                   @default(now()) @map("linked_at")
  lastRefreshedAt              DateTime?                  @map("last_refreshed_at")
  /// Last creator-initiated refresh request (cooldown anchor for manual refresh).
  lastManualRefreshRequestedAt DateTime?                  @map("last_manual_refresh_requested_at")
  /// Per-destination analytics role when handoff used preview/substitute media (e.g. promo on X).
  contentVariantRole           CreativeWorkVariantRole?   @map("content_variant_role")
  createdAt                    DateTime                   @default(now()) @map("created_at")
  updatedAt                    DateTime                   @updatedAt @map("updated_at")

  metricSnapshots ExternalPostMetricSnapshot[]

  @@unique([postId, destination])
  @@index([creatorId, destination])
  @@index([creatorId, status])
  @@index([externalUrl])
  @@map("platform_instances")
}

/// WI-5 — creator monthly Relay-native posting goal.
model CreatorPostingGoal {
  creatorId          String   @id @map("creator_id")
  /// Required during creator onboarding. Default is intentionally gentle: 1 Relay-native post/month.
  monthlyPostTarget  Int      @default(1) @map("monthly_post_target")
  /// Optional: suggest one extra post when the goal is already met and staged media is available.
  bonusNudgesEnabled Boolean  @default(false) @map("bonus_nudges_enabled")
  /// IANA timezone for calendar-month windows. Default UTC until browser/profile timezone is available.
  timezone           String   @default("UTC")
  enabled            Boolean  @default(true)
  /// Phase 5 — global Remind me gate for schedule-rail + extension sticky toasts (default on).
  remindMeGlobal     Boolean  @default(true) @map("remind_me_global")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("creator_posting_goals")
}

/// WI-5 — one active/snoozed/skipped nudge per creator/month/type.
model CreatorPostingNudge {
  id           String    @id @default(cuid())
  creatorId    String    @map("creator_id")
  /// Creator-local month key, e.g. "2026-06".
  periodKey    String    @map("period_key")
  /// "posting_goal" | "bonus_post" (kept as string for forward compatibility).
  nudgeType    String    @default("posting_goal") @map("nudge_type")
  /// "active" | "snoozed" | "skipped" | "resolved".
  status       String    @default("active")
  snoozedUntil DateTime? @map("snoozed_until")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([creatorId, periodKey, nudgeType])
  @@index([status, snoozedUntil])
  @@map("creator_posting_nudges")
}

/// Manually-set per-creator feature gates (no billing system yet — flip via ops route or CLI script).
/// One row per creator; missing row == all flags default off. Superseded by real plan/billing later.
model CreatorFeatureFlag {
  creatorId               String   @id @map("creator_id")
  postingAssistantEnabled Boolean  @default(false) @map("posting_assistant_enabled")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("creator_feature_flags")
}

/// Durable Insights Action Hub studio brief (PostingAssistantContext fields at creator scope).
/// Consumed by Edit brief, Coach propose, and (queued) Autopost / PostBot cross-talk.
model CreatorStudioBrief {
  creatorId String   @id @map("creator_id")
  /// AssistantGoal[] JSON — max 2 synergistic path goals.
  goals     Json     @default("[]")
  userNotes String?  @map("user_notes") @db.Text
  locale    String?
  trendNote String?  @map("trend_note") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("creator_studio_briefs")
}

/// Goal Cycle (VS1) — creator-scoped bounded planning run.
/// One active cycle per creator via unique (creator_id, active_scope) where active_scope = "active".
model CreatorGoalCycle {
  id                    String    @id @default(cuid())
  creatorId             String    @map("creator_id")
  /// draft | researching | questions | review | approved | materializing | active | completion_suggested | completed | cancelled | failed
  state                 String    @default("draft")
  /// goal | context | research | questions | revisions | logistics | approval | active | completion | learning
  phase                 String    @default("goal")
  /// engagement | views | paid_support | break
  goalKind              String    @map("goal_kind")
  /// complete_silence | social_upkeep | active_rest — only when goalKind = break
  breakMode             String?   @map("break_mode")
  /// Creator-local month key, e.g. "2026-07"
  periodKey             String    @map("period_key")
  timeZone              String    @default("UTC") @map("time_zone")
  contextJson           Json      @default("{}") @map("context_json")
  /// Set to "active" while nonterminal; null when completed/cancelled/failed. Unique with creatorId.
  activeScope           String?   @map("active_scope")
  version               Int       @default(1)
  /// Idempotency key from start request (retry returns same cycle).
  startIdempotencyKey   String?   @map("start_idempotency_key")
  reservationRef        String?   @map("reservation_ref")
  approvedAt            DateTime? @map("approved_at")
  materializedAt        DateTime? @map("materialized_at")
  completionSuggestedAt DateTime? @map("completion_suggested_at")
  completedAt           DateTime? @map("completed_at")
  cancelledAt           DateTime? @map("cancelled_at")
  cancelReason          String?   @map("cancel_reason")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  checkpoint              CreatorGoalCycleCheckpoint?
  revisions               CreatorGoalCycleRevision[]
  slots                   CreatorGoalCycleSlot[]
  progress                CreatorGoalCycleProgress[]
  outcome                 CreatorGoalCycleOutcome?
  creditReservation       CoachPlanCreditReservation?
  creditLedgerEntries     CoachPlanCreditLedger[]
  trendRuns               GoalCycleTrendRun[]
  supportOutcomes         GoalCycleSupportOutcome[]
  attributionSnapshots    GoalCycleAttributionSnapshot[]
  materializationReceipts CreatorGoalCycleMaterializationReceipt[]

  @@unique([creatorId, activeScope])
  @@unique([creatorId, startIdempotencyKey])
  @@index([creatorId, periodKey])
  @@index([creatorId, state])
  @@map("creator_goal_cycles")
}

/// Trend evidence run + cache row (VS3-T03). Raw provider payloads are not stored by default.
model GoalCycleTrendRun {
  id                   String    @id @default(cuid())
  creatorId            String    @map("creator_id")
  cycleId              String?   @map("cycle_id")
  /// Client request idempotency key (retry returns same completed run).
  requestId            String    @map("request_id")
  /// Hash of normalized topic + locale + geography + window.
  queryHash            String    @map("query_hash")
  /// Cache key: query + mode + provider versions (creator-scoped lookup).
  cacheKey             String    @map("cache_key")
  /// disabled | fixture | history_only | live
  mode                 String
  providerIdsJson      Json      @default("[]") @map("provider_ids_json")
