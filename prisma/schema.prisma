enum CreatorScheduleSeriesStatus {
  active
  paused
  ended
}

enum CreatorScheduleSeriesCadence {
  weekly
  monthly
}

/// Ordinary series create Relay posts; automation-owned series only fire trigger ticks (VS4).
enum CreatorScheduleSeriesMaterializationKind {
  post_draft
  automation_trigger
}

enum CreatorScheduleOccurrenceStatus {
  planned
  materialized
  completed
  skipped
  failed
}

enum CreatorAutomationStatus {
  active
  paused
  archived
}

/// Autopost recurring posting routine (calendar template — not RRULE).
model CreatorScheduleSeries {
  id                  String                                   @id @default(cuid())
  creatorId           String                                   @map("creator_id")
  status              CreatorScheduleSeriesStatus              @default(active)
  cadence             CreatorScheduleSeriesCadence
  /// Interval multiplier (every N weeks/months). Default 1.
  interval            Int                                      @default(1)
  /// Local wall-clock HH:mm (24h).
  localTime           String                                   @map("local_time")
  timezone            String                                   @default("UTC")
  /// Weekly: 0=Sun … 6=Sat. Empty when monthly.
  weekdays            Int[]                                    @default([])
  /// Monthly: day-of-month 1–31. Empty when weekly. Short months clamp to last valid day.
  monthDays           Int[]                                    @default([]) @map("month_days")
  /// text | image | video | mixed
  plannedFormat       String                                   @default("mixed") @map("planned_format")
  destinations        String[]                                 @default([])
  remindMe            Boolean                                  @default(true) @map("remind_me")
  titleHint           String?                                  @map("title_hint")
  startsAt            DateTime                                 @map("starts_at")
  endsAt              DateTime?                                @map("ends_at")
  /// Optional seed event / post that created this series.
  sourcePostId        String?                                  @map("source_post_id")
  lastError           String?                                  @map("last_error") @db.Text
  /// post_draft (default, legacy) | automation_trigger (Automations connector series).
  materializationKind CreatorScheduleSeriesMaterializationKind @default(post_draft) @map("materialization_kind")
  createdAt           DateTime                                 @default(now()) @map("created_at")
  updatedAt           DateTime                                 @updatedAt @map("updated_at")

  occurrences CreatorScheduleOccurrence[]
  /// Optional one-to-one Automations connector ownership (null = ordinary / unowned series).
  automation  CreatorAutomation?

  @@index([creatorId, status])
  @@index([status, updatedAt])
  @@index([materializationKind, status])
  @@map("creator_schedule_series")
}

/// Lightweight calendar occurrence for a series (draft materialization is just-in-time).
model CreatorScheduleOccurrence {
  id             String                          @id @default(cuid())
  seriesId       String                          @map("series_id")
  series         CreatorScheduleSeries           @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  creatorId      String                          @map("creator_id")
  /// Stable local key e.g. "2026-08-15" — unique per series.
  occurrenceKey  String                          @map("occurrence_key")
  dueAt          DateTime                        @map("due_at")
  status         CreatorScheduleOccurrenceStatus @default(planned)
  postId         String?                         @map("post_id")
  draftId        String?                         @map("draft_id")
  primaryTaskId  String?                         @map("primary_task_id")
  failureReason  String?                         @map("failure_reason") @db.Text
  materializedAt DateTime?                       @map("materialized_at")
  completedAt    DateTime?                       @map("completed_at")
  createdAt      DateTime                        @default(now()) @map("created_at")
  updatedAt      DateTime                        @updatedAt @map("updated_at")

  distributionRuleRuns CreatorDistributionRuleRun[]

  @@unique([seriesId, occurrenceKey])
  @@index([creatorId, dueAt])
  @@index([creatorId, status, dueAt])
  @@index([status, dueAt])
  @@map("creator_schedule_occurrences")
}

enum CreatorDistributionRuleStatus {
  active
  paused
}

enum CreatorDistributionRuleRunStatus {
  pending
  materialized
  completed
  failed
  skipped
  /// Approval TTL elapsed without creator action (Automations).
  expired
  /// Creator cancelled pending approval / connector lifecycle cancelled the run.
  cancelled
}

/// Autopost content-relative rule: after Patreon publish, prepare preview drafts later.
model CreatorDistributionRule {
  id                 String                        @id @default(cuid())
  creatorId          String                        @map("creator_id")
  status             CreatorDistributionRuleStatus @default(active)
  /// Locked v1 trigger: patreon_published
  triggerKind        String                        @default("patreon_published") @map("trigger_kind")
  /// Days after source publish before materializing draft.
  offsetDays         Int                           @default(30) @map("offset_days")
  targetDestinations String[]                      @default([]) @map("target_destinations")
  /// Locked v1: preview
  transformMode      String                        @default("preview") @map("transform_mode")
  remindMe           Boolean                       @default(true) @map("remind_me")
  /// Always true in v1 — automation never auto-publishes.
  draftOnly          Boolean                       @default(true) @map("draft_only")
  title              String?
  lastError          String?                       @map("last_error") @db.Text
  createdAt          DateTime                      @default(now()) @map("created_at")
  updatedAt          DateTime                      @updatedAt @map("updated_at")

  runs       CreatorDistributionRuleRun[]
  /// Optional one-to-one Automations connector ownership (null = legacy / unowned rule).
  automation CreatorAutomation?

  @@index([creatorId, status])
  @@map("creator_distribution_rules")
}

model CreatorDistributionRuleRun {
  id                      String                           @id @default(cuid())
  ruleId                  String                           @map("rule_id")
  rule                    CreatorDistributionRule          @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  creatorId               String                           @map("creator_id")
  sourcePostId            String                           @map("source_post_id")
  sourcePublishedAt       DateTime                         @map("source_published_at")
  dueAt                   DateTime                         @map("due_at")
  status                  CreatorDistributionRuleRunStatus @default(pending)
  draftId                 String?                          @map("draft_id")
  planId                  String?                          @map("plan_id")
  failureReason           String?                          @map("failure_reason") @db.Text
  materializedAt          DateTime?                        @map("materialized_at")
  /// Stable action-run key: rule:{ruleId}:post:{sourcePostId} or occurrence:{occurrenceId}.
  /// Empty default is replaced by DB trigger for legacy insert paths; prefer explicit keys in services.
  idempotencyKey          String                           @default("") @map("idempotency_key")
  /// Scheduled Automations: correlate to trigger occurrence (optional for delayed-release runs).
  scheduleOccurrenceId    String?                          @map("schedule_occurrence_id")
  scheduleOccurrence      CreatorScheduleOccurrence?       @relation(fields: [scheduleOccurrenceId], references: [id], onDelete: SetNull)
  /// Rail attention event created for approval (manual_event path).
  materializedEventId     String?                          @map("materialized_event_id")
  materializedEvent       CreatorScheduleEvent?            @relation(fields: [materializedEventId], references: [id], onDelete: SetNull)
  /// Snapshot of CreatorPreviewTemplate.config at materialization (survives template delete).
  previewTemplateSnapshot Json?                            @map("preview_template_snapshot")
  expiresAt               DateTime?                        @map("expires_at")
  completedAt             DateTime?                        @map("completed_at")
  createdAt               DateTime                         @default(now()) @map("created_at")
  updatedAt               DateTime                         @updatedAt @map("updated_at")

  @@unique([ruleId, sourcePostId])
  @@unique([idempotencyKey])
  @@index([creatorId, status, dueAt])
  @@index([status, dueAt])
  @@index([scheduleOccurrenceId])
  @@index([materializedEventId])
  @@index([status, expiresAt])
  @@map("creator_distribution_rule_runs")
}

/// Schedule Rail Automations connector — composition/config only (not a run ledger).
/// Action runs live on CreatorDistributionRuleRun; calendar ticks on CreatorScheduleOccurrence.
model CreatorAutomation {
  id                 String                  @id @default(cuid())
  creatorId          String                  @map("creator_id")
  /// preview_crosspost | delayed_public_release
  presetKind         String                  @map("preset_kind")
  status             CreatorAutomationStatus @default(active)
  title              String
  /// latest_patreon_post | triggering_patreon_post
  sourceKind         String                  @map("source_kind")
  scheduleSeriesId   String?                 @unique @map("schedule_series_id")
  scheduleSeries     CreatorScheduleSeries?  @relation(fields: [scheduleSeriesId], references: [id], onDelete: SetNull)
  distributionRuleId String                  @unique @map("distribution_rule_id")
  distributionRule   CreatorDistributionRule @relation(fields: [distributionRuleId], references: [id], onDelete: Restrict)
  previewTemplateId  String?                 @map("preview_template_id")
  previewTemplate    CreatorPreviewTemplate? @relation(fields: [previewTemplateId], references: [id], onDelete: SetNull)
  approvalTtlHours   Int                     @default(72) @map("approval_ttl_hours")
  /// Conflict-safe patch version (monotonic).
  version            Int                     @default(1)
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  @@index([creatorId, status])
  @@index([creatorId, presetKind])
  @@index([previewTemplateId])
  @@map("creator_automations")
}

