// --- P5a pilot analytics (DDL P5a-db-002) — event ledger, Insights import, first-party engagement. ---

enum CreatorMembershipEventType {
  join
  upgrade
  downgrade
  cancel
  rejoin
}

enum CreatorMembershipEventSource {
  sync
  webhook
  backfill
}

enum RelayEngagementEventType {
  gallery_view
  reveal_interaction
  profile_view
}

/// Append-only Patreon membership lifecycle (opaque `patreon_member_id` only).
/// **Idempotency (P5a-db-003):** at most one row per `(creator_id, patreon_member_id, event_type, occurred_at)` so sync/webhook replays cannot double-insert the same logical event. If upstream ever collides within the same `TIMESTAMP(3)` bucket, introduce a separate `dedupe_key` column + unique instead.
model CreatorMembershipEvent {
  id              String                       @id @default(cuid())
  creatorId       String                       @map("creator_id")
  patreonMemberId String                       @map("patreon_member_id")
  eventType       CreatorMembershipEventType   @map("event_type")
  occurredAt      DateTime                     @map("occurred_at")
  tierId          String?                      @map("tier_id")
  amountCents     Int?                         @map("amount_cents")
  source          CreatorMembershipEventSource
  payload         Json?

  @@unique([creatorId, patreonMemberId, eventType, occurredAt])
  @@index([creatorId, occurredAt])
  @@map("creator_membership_events")
}

/// Header for one Patreon Insights CSV upload; idempotent per `(creator_id, file_hash)`.
model PatreonInsightsImport {
  id          String                      @id @default(cuid())
  creatorId   String                      @map("creator_id")
  fileHash    String                      @map("file_hash")
  uploadedAt  DateTime                    @default(now()) @map("uploaded_at")
  label       String?
  postMetrics PatreonInsightsPostMetric[]

  @@unique([creatorId, fileHash])
  @@index([creatorId])
  @@map("patreon_insights_imports")
}

/// Per-post metrics from one import (child of `PatreonInsightsImport`).
model PatreonInsightsPostMetric {
  id            String                @id @default(cuid())
  importId      String                @map("import_id")
  import        PatreonInsightsImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  creatorId     String                @map("creator_id")
  patreonPostId String                @map("patreon_post_id")
  impressions   Int?
  /// CSV "Seen" column.
  seen          Int?                  @map("seen")
  likes         Int?
  comments      Int?                  @map("comments")
  asOf          DateTime?             @map("as_of")
  postId        String?               @map("post_id")
  post          Post?                 @relation(fields: [postId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([importId])
  @@index([creatorId, patreonPostId])
  @@map("patreon_insights_post_metrics")
}

/// First-party Relay engagement (no Patreon user PII; optional opaque `session_key` only).
model RelayEngagementEvent {
  id         String                   @id @default(cuid())
  creatorId  String                   @map("creator_id")
  eventType  RelayEngagementEventType @map("event_type")
  occurredAt DateTime                 @map("occurred_at")
  postId     String?                  @map("post_id")
  post       Post?                    @relation(fields: [postId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  mediaId    String?                  @map("media_id")
  media      MediaAsset?              @relation(fields: [mediaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sessionKey String?                  @map("session_key")

  @@index([creatorId, occurredAt])
  @@map("relay_engagement_events")
}

/// PMD-041 — cross-tenant first-party telemetry (page_view, session_start, feed_open, …).
model PlatformTelemetryEvent {
