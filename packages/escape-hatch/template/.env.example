# Escape Hatch site — environment names only
# Copy to `.env.local` or your host secret store. NEVER commit real secrets.

# --- Optional for local preview / next build (chassis works without these) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_SITE_NAME=

# --- Identity provider (EH-031). Not required for npm run build. ---
# none | unset — local preview (soft personas; local-operator admin)
# supabase — Path A (EH-030 Supabase Auth/Postgres)
# portable — Path B (creator-owned Postgres + app-managed auth)
# Unknown values fail closed.
# ESCAPE_HATCH_IDENTITY_PROVIDER=none

# --- Path A: creator-owned Supabase (EH-030). ---
# When provider is unset and these are real/non-placeholder, Path A auto-selects
# (EH-030 compat). Soft personas never authorize admin when Path A/B is active.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Path B: portable Postgres + app-managed auth (EH-031). ---
# Requires ESCAPE_HATCH_IDENTITY_PROVIDER=portable (never auto-selected).
# Compose loopback example (profile db binds 127.0.0.1:5433 only):
# DATABASE_URL=postgresql://escape_hatch:escape_hatch_dev_only@127.0.0.1:5433/escape_hatch
# ESCAPE_HATCH_SESSION_SECRET=
# Optional: ESCAPE_HATCH_COOKIE_SECURE=1 to force Secure cookies outside NODE_ENV=production

# --- Private media delivery (EH-033). Default prefers private. ---
# public_legacy | private_r2 | local_private
# Unset: private_r2 when R2 signing env is real; otherwise local_private.
# ESCAPE_HATCH_MEDIA_MODE=local_private
# Short-lived signed GET TTL (seconds; clamped, default 60):
# ESCAPE_HATCH_MEDIA_SIGNED_URL_TTL_SEC=60
# R2 / S3-compatible (required for private_r2; names only — never commit secrets):
# R2_ENDPOINT=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=
# R2_REGION=auto
# Deny public ACLs on the premium bucket. Rotate access keys in the host secret store.
# Tests may set ESCAPE_HATCH_MEDIA_SIGNER=mock (no live R2).

# --- Optional billing adapters (EH-050+). Not required for npm run build. ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Creator-owned Patreon OAuth (EH-040). Not required for npm run build. ---
# unset / none → stub. creator_oauth → require all fields below (non-placeholder).
# relay_managed is EH-041 (not implemented here).
# ESCAPE_HATCH_PATREON_MODE=creator_oauth
# PATREON_CLIENT_ID=
# PATREON_CLIENT_SECRET=
# Exact callback registered in the Patreon developer portal, e.g.:
# PATREON_REDIRECT_URI=http://localhost:3001/api/patreon/oauth/callback
# Numeric campaign id to validate memberships against:
# PATREON_CAMPAIGN_ID=
# Creator-owned AES-256 key for refresh tokens at rest (32 bytes as base64 or 64-char hex):
# ESCAPE_HATCH_PATREON_TOKEN_KEY=
# HMAC secret for OAuth state (min 16 chars):
# ESCAPE_HATCH_PATREON_OAUTH_STATE_SECRET=
# Optional URL overrides for tests only (do not point CI at live Patreon):
# ESCAPE_HATCH_PATREON_AUTHORIZE_URL=
# ESCAPE_HATCH_PATREON_TOKEN_URL=
# ESCAPE_HATCH_PATREON_IDENTITY_URL=
