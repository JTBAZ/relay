{
  "manifest_version": 3,
  "name": "Relay — Patreon connector",
  "version": "0.1.0",
  "description": "Connect Patreon to Relay for backups and cross-post drafts. You review and publish manually in Patreon.",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Relay",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "permissions": ["cookies", "alarms", "storage", "scripting"],
  "host_permissions": [
    "https://www.patreon.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.deviantart.com/*",
    "https://relayapp.me/*",
    "http://localhost:*/*"
  ],
  "externally_connectable": {
    "matches": ["https://relayapp.me/*", "http://localhost:*/*"]
  }
}
