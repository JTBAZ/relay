# Copy to `.env.local` in this folder (`web/`) for local Next.js + Relay API dev.
#
# Steps:
#   1. cp .env.local.example .env.local   (or copy manually on Windows)
#   2. From repo root: npm run build && npm start   (Relay API, default :8787)
#   3. From web/: npm run dev   (Next on :3000; see package.json)
#
# Full catalog (Supabase, Patreon, patron feed toggles, etc.): `.env.example` in this folder.

# Browser + Relay API origin — no trailing slash. Same value is read by next.config.mjs for rewrites
# (e.g. GET /api/relay/library-zip → ${NEXT_PUBLIC_RELAY_API_URL}/api/v1/export/library-zip).
NEXT_PUBLIC_RELAY_API_URL=http://127.0.0.1:8787

# Canonical site origin for emailRedirectTo, Patreon redirect_uri helpers, and public links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Relay browser extension — local unpacked Chrome build (extension/dist/chrome-dev).
# Must match RELAY_EXTENSION_ORIGINS in repo root `.env` (chrome-extension://… prefix on API side).
NEXT_PUBLIC_RELAY_EXTENSION_IDS=kedlnmnhjmgckpagfaamdckioaabccmn

# InstallExtensionPrompt (onboarding step 4): without any of these, the UI shows a dev warning. For local dev you can use
# official sideload/unpacked docs; replace with real store URLs when the extension is listed (see `web/.env.example`).
# NEXT_PUBLIC_RELAY_EXTENSION_CHROME_URL=https://developer.chrome.com/docs/extensions/mv3/getstarted/#load-unpacked
# NEXT_PUBLIC_RELAY_EXTENSION_EDGE_URL=https://learn.microsoft.com/en-us/microsoft-edge/extensions-chromium/getting-started/extension-sideloading
# NEXT_PUBLIC_RELAY_EXTENSION_FIREFOX_URL=https://extensionworkshop.com/documentation/develop/temporary-installation-in-firefox/
#
# Creator onboarding step 4: show extension store CTAs. Leave unset until the extension ships (default hides that block).
# NEXT_PUBLIC_RELAY_EXTENSION_ONBOARDING_PROMPT=1

# Previewizer in Autopost/distribution (default on). Set to 0 to hide Open Previewizer;
# artists can still pick an existing preview image or send full media.
# NEXT_PUBLIC_RELAY_PREVIEWIZER_ENABLED=1
