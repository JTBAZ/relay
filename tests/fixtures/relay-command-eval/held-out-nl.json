        "query": { "tag_ids": ["sl2_tag_watercolor", "sl2_tag_landscape"] }
      }
    },
    {
      "id": "nl-compound-hero",
      "category": "compound",
      "instruction": "make a hero academy stack, cover then the pages in order",
      "expected": {
        "kind": "selection_intent",
        "query": { "title_contains": "Hero Academy" }
      }
    },
    {
      "id": "nl-typo-hero",
      "category": "typo",
      "instruction": "organize Herro Academy into a collection",
      "expected": {
        "kind": "selection_intent",
        "query": { "title_contains": "Hero Academy" }
      }
    },
    {
      "id": "nl-ambiguous-academy",
      "category": "ambiguity",
      "instruction": "put my academy stuff in a pile",
